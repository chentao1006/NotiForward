    "Click Grant Access to let %@ read the Notification Center folder. Nothing else on your Mac is accessed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Grant Access to let %@ read the Notification Center folder. Nothing else on your Mac is accessed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“授权访问”，允许%@读取通知中心文件夹。不会访问 Mac 上的其他任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下「授權取用」，允許%@讀取通知中心檔案夾。不會取用 Mac 上的其他任何內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アクセスを許可」をクリックすると、%@ が通知センターのフォルダを読み取れるようになります。Mac 上のほかの内容にはアクセスしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘접근 허용’을 클릭하면 %@이(가) 알림 센터 폴더를 읽을 수 있습니다. Mac의 다른 항목에는 접근하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf „Zugriff erlauben“, damit %@ den Mitteilungszentrale-Ordner lesen kann. Auf nichts anderes auf deinem Mac wird zugegriffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur « Autoriser l’accès » pour que %@ puisse lire le dossier du Centre de notifications. Rien d’autre sur votre Mac n’est consulté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en «Conceder acceso» para que %@ pueda leer la carpeta del Centro de notificaciones. No se accede a nada más de tu Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su «Consenti accesso» per permettere a %@ di leggere la cartella del Centro notifiche. Nient’altro sul tuo Mac viene letto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em “Conceder acesso” para que o %@ leia a pasta da Central de Notificações. Nada mais no seu Mac é acessado."
          }
        }
      }
    },
