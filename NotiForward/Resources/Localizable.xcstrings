{
  "sourceLanguage": "en",
  "strings": {
    "%@ reads only the Notification Center folder, which you grant once. Forwarding starts within a few seconds.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reads only the Notification Center folder, which you grant once. Forwarding starts within a few seconds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@只读取你授权的通知中心文件夹，只需授权一次。授权后几秒内即开始转发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@只讀取你授權的通知中心檔案夾，只需授權一次。授權後幾秒內即開始轉送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が読み取るのは、一度だけ許可する通知センターのフォルダのみです。許可すると数秒以内に転送が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 한 번 허용한 알림 센터 폴더만 읽습니다. 허용하면 몇 초 안에 전달이 시작됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liest nur den Mitteilungszentrale-Ordner, den du einmalig freigibst. Die Weiterleitung startet danach in wenigen Sekunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lit uniquement le dossier du Centre de notifications, que vous autorisez une seule fois. Le transfert démarre ensuite en quelques secondes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solo lee la carpeta del Centro de notificaciones, que autorizas una sola vez. El reenvío empieza en unos segundos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ legge solo la cartella del Centro notifiche, che autorizzi una sola volta. L’inoltro inizia entro pochi secondi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ lê apenas a pasta da Central de Notificações, que você autoriza uma única vez. O encaminhamento começa em poucos segundos."
          }
        }
      }
    },
    "%@ uses Bark, a free open-source iPhone app, to receive notifications. Install Bark on your iPhone first. Forwarded notifications pass through the Bark server set below.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uses Bark, a free open-source iPhone app, to receive notifications. Install Bark on your iPhone first. Forwarded notifications pass through the Bark server set below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@使用免费开源的 iPhone 应用 Bark 接收通知。请先在 iPhone 上安装 Bark。转发的通知会经过下方设置的 Bark 服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@使用免費開源的 iPhone App Bark 接收通知。請先在 iPhone 上安裝 Bark。轉送的通知會經過下方設定的 Bark 伺服器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は、無料のオープンソース iPhone アプリ Bark で通知を受け取ります。まず iPhone に Bark をインストールしてください。転送された通知は、下で設定した Bark サーバを経由します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 무료 오픈 소스 iPhone 앱 Bark로 알림을 받습니다. 먼저 iPhone에 Bark를 설치하세요. 전달된 알림은 아래에 설정한 Bark 서버를 거칩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ empfängt Mitteilungen mit Bark, einer kostenlosen Open-Source-App für das iPhone. Installiere zuerst Bark auf deinem iPhone. Weitergeleitete Mitteilungen laufen über den unten eingestellten Bark-Server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise Bark, une app iPhone gratuite et open source, pour recevoir les notifications. Installez d’abord Bark sur votre iPhone. Les notifications transférées passent par le serveur Bark défini ci-dessous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa Bark, una app gratuita y de código abierto para iPhone, para recibir las notificaciones. Instala primero Bark en tu iPhone. Las notificaciones reenviadas pasan por el servidor de Bark configurado abajo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa Bark, un’app per iPhone gratuita e open source, per ricevere le notifiche. Installa prima Bark sul tuo iPhone. Le notifiche inoltrate passano dal server Bark impostato qui sotto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ usa o Bark, um app gratuito e de código aberto para iPhone, para receber as notificações. Instale primeiro o Bark no seu iPhone. As notificações encaminhadas passam pelo servidor Bark definido abaixo."
          }
        }
      }
    },
