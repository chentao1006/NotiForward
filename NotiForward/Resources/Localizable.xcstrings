    "If hidden, open %@ again to restore the menu bar icon.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If hidden, open %@ again to restore the menu bar icon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏后，再次打开%@即可恢复菜单栏图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏後，再次開啟%@即可恢復選單列圖像。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示にした場合は、%@ をもう一度開くとメニューバーアイコンが戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨긴 경우 %@을(를) 다시 열면 메뉴 막대 아이콘이 복원됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ausgeblendet, öffne %@ erneut, um das Menüleistensymbol wiederherzustellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si elle est masquée, rouvrez %@ pour restaurer l’icône de la barre des menus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se oculta, vuelve a abrir %@ para restaurar el icono de la barra de menús."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se nascosta, riapri %@ per ripristinare l’icona nella barra dei menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se estiver oculto, abra o %@ novamente para restaurar o ícone da barra de menus."
          }
        }
      }
    },
