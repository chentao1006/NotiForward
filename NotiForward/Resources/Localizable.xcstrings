    "Paste the device token from Bark, or the key from its server list. A full URL such as https://api.day.app/yourkey/ also works.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the device token from Bark, or the key from its server list. A full URL such as https://api.day.app/yourkey/ also works."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴 Bark 中的设备 Token，或服务器列表中的密钥。也可以直接粘贴完整地址，例如 https://api.day.app/yourkey/。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上 Bark 中的裝置 Token，或伺服器列表中的密鑰。也可以直接貼上完整網址，例如 https://api.day.app/yourkey/。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bark のデバイストークン、またはサーバ一覧のキーを貼り付けてください。https://api.day.app/yourkey/ のような URL も使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bark의 기기 토큰이나 서버 목록의 키를 붙여넣으세요. https://api.day.app/yourkey/ 와 같은 전체 URL도 사용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge das Geräte-Token aus Bark oder den Schlüssel aus der Serverliste ein. Eine vollständige URL wie https://api.day.app/yourkey/ funktioniert ebenfalls."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez le jeton d’appareil de Bark ou la clé de sa liste de serveurs. Une URL complète comme https://api.day.app/yourkey/ fonctionne aussi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el token de dispositivo de Bark o la clave de su lista de servidores. También sirve una URL completa como https://api.day.app/yourkey/."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla il token dispositivo di Bark o la chiave dall’elenco dei server. Funziona anche un URL completo come https://api.day.app/yourkey/."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole o token do dispositivo do Bark ou a chave da lista de servidores. Uma URL completa como https://api.day.app/yourkey/ também funciona."
          }
        }
      }
    },
