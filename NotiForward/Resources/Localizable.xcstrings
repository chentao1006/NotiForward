    "Looks up icons on the App Store by bundle ID. Apps not on the App Store show Bark’s icon.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks up icons on the App Store by bundle ID. Apps not on the App Store show Bark’s icon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Bundle ID 在 App Store 查找图标。不在 App Store 上架的应用显示 Bark 的图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Bundle ID 在 App Store 尋找圖像。未在 App Store 上架的 App 會顯示 Bark 的圖像。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle ID をもとに App Store でアイコンを探します。App Store にないアプリは Bark のアイコンになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번들 ID로 App Store에서 아이콘을 찾습니다. App Store에 없는 앱은 Bark 아이콘이 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht Symbole anhand der Bundle-ID im App Store. Apps, die nicht im App Store sind, zeigen das Bark-Symbol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche les icônes sur l’App Store à partir de l’identifiant de bundle. Les apps absentes de l’App Store affichent l’icône de Bark."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca los iconos en la App Store por ID de paquete. Las apps que no están en la App Store muestran el icono de Bark."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca le icone su App Store tramite l’ID bundle. Le app non presenti su App Store mostrano l’icona di Bark."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca os ícones na App Store pelo ID do pacote. Apps fora da App Store mostram o ícone do Bark."
          }
        }
      }
    },
