    "Uses the Mac app’s URL scheme, such as tg:// for Telegram. Apps without the same scheme on iPhone just open Bark.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the Mac app’s URL scheme, such as tg:// for Telegram. Apps without the same scheme on iPhone just open Bark."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Mac 应用的 URL Scheme，例如 Telegram 的 tg://。iPhone 上没有相同 Scheme 的应用会只打开 Bark。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Mac App 的 URL Scheme，例如 Telegram 的 tg://。iPhone 上沒有相同 Scheme 的 App 只會打開 Bark。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac アプリの URL スキーム（Telegram なら tg://）を使います。iPhone に同じスキームがないアプリは Bark が開くだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 앱의 URL 스킴(예: Telegram의 tg://)을 사용합니다. iPhone에 같은 스킴이 없는 앱은 Bark만 열립니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet das URL-Schema der Mac-App, etwa tg:// für Telegram. Bei Apps ohne gleiches Schema auf dem iPhone öffnet sich nur Bark."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le schéma d’URL de l’app Mac, par exemple tg:// pour Telegram. Pour les apps sans le même schéma sur iPhone, seul Bark s’ouvre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el esquema de URL de la app de Mac, como tg:// para Telegram. Las apps sin el mismo esquema en el iPhone solo abren Bark."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa lo schema URL dell’app per Mac, ad esempio tg:// per Telegram. Per le app senza lo stesso schema su iPhone si apre solo Bark."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o esquema de URL do app do Mac, como tg:// para o Telegram. Apps sem o mesmo esquema no iPhone apenas abrem o Bark."
          }
        }
